model User {
  id              String     @id @default(uuid())
  email           String?    @unique // nullable — Apple can hide email
  phone           String?    @unique // optional — for OTP via SMS
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  reason          String?
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  isOnboarded     Boolean    @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // DELETED
  isDeleted Boolean   @default(false)
  deletedAt DateTime? // soft delete

  profile              Profile?
  credentials          Credential[]
  sessions             Session[]
  twoFactorMethods     TwoFactorMethod[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  fcmDeviceTokens      FcmDeviceToken[]
  notifications        Notification[]
  maintainer           Maintainer?
  driver               Driver?
  organizationMembers  OrganizationMember[]
  // DB relations
  createdMaintainers         Maintainer[]         @relation("MaintainerCreatedBy")
  createdOrganizations       Organization[]       @relation("OrganizationCreatedBy")
  approvedOrganizations      Organization[]       @relation("OrganizationApprovedBy")
  createdOrganizationMembers OrganizationMember[] @relation("OrganizationMemberCreatedBy")
  createdFleets              Fleet[]              @relation("FleetCreatedBy")
  createdFleetMembers        FleetMember[]        @relation("FleetMemberCreatedBy")
  createdDrivers             Driver[]             @relation("DriverCreatedBy")
  createdAttorneys           Attorney[]           @relation("AttorneyCreatedBy")
  createdCases               Case[]               @relation("CaseCreatedBy")
  caseStatusChanges          CaseStatusHistory[]  @relation("CaseStatusChangedBy")
  triggeredIncidentAlerts    IncidentAlert[]      @relation("IncidentTriggeredBy")
  acknowledgedIncidentAlerts IncidentAlert[]      @relation("IncidentAcknowledgedBy")
  createdHazardReports       HazardReport[]       @relation("HazardCreatedByUser")
  templates                  Template[]
  emailDispatchesSent        EmailDispatch[] @relation("EmailDispatchSentBy")
  emailDispatchesReceived    EmailDispatch[] @relation("EmailDispatchRecipientUser")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  name      String?
  avatarUrl String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?

  @@map("profiles")
}
