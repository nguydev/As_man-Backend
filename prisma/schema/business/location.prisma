enum IncidentAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentAlertType {
  SOS
  DETENTION
}

model LocationHistory {
  id         String   @id @default(uuid())
  driverId   String
  lat        Decimal  @db.Decimal(9, 6)
  lon        Decimal  @db.Decimal(9, 6)
  speed      Decimal? @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(6, 2)
  deviceTs   DateTime
  receivedTs DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, deviceTs])
  @@index([receivedTs])
  @@map("location_history")
}

model IncidentAlert {
  id               String              @id @default(uuid())
  driverId         String
  caseId           String?
  type             IncidentAlertType
  status           IncidentAlertStatus @default(OPEN)
  lat              Decimal?            @db.Decimal(9, 6)
  lon              Decimal?            @db.Decimal(9, 6)
  message          String?
  triggeredById    String?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver         Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  case           Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  triggeredBy    User?  @relation("IncidentTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  acknowledgedBy User?  @relation("IncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([driverId, status])
  @@index([caseId])
  @@index([type, status])
  @@index([createdAt])
  @@map("incident_alerts")
}
